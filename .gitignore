# Python bytecode, regenerated automatically
__pycache__/
*.pyc

# Data and temporary files created when the server runs
assets_*.json
*.tmp

# Accounts and the token-signing key, which must never be shared publicly
users.json
secret.key

# Audit logs written by the servers
*.log

# The private key for TLS, which must never be shared
server.key
server.crt

# Left behind by working on the extend-system branch in this same folder. None of it
# belongs on this branch: built programs, the web accounts (password hashes), the
# certificate and everything else the running system writes.
*.exe
data/
tls.pem
web_users.json
web_password.json
